<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ extraction rules: exclude the credential SharedPreferences
     file from both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="openpets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="openpets.xml" />
    </device-transfer>
</data-extraction-rules>
